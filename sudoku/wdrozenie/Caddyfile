# Sudoku — sam ten blok, do wspólnego Caddyfile (obok Statków).
# Nie zastępuj całego pliku. mise run wdroz dopisuje go między znacznikami.
# Port jest w PORT_SUDOKU (mise.local.toml), nie w tym pliku.
# Pliki gry muszą być w kontenerze pod /srv/sudoku (wolumin z hosta).

{$DOMENA}:{$PORT_SUDOKU} {
	encode gzip
	root * /srv/sudoku
	@bezcache path /sw.js /manifest.webmanifest
	header @bezcache Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"
	file_server
}

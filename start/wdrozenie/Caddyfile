# Strona startowa — sam ten blok, do wspólnego Caddyfile (obok gier).
# Nie zastępuj całego pliku. mise run wdroz dopisuje go między znacznikami.
# Port jest w PORT_START (mise.local.toml), nie w tym pliku.
# Pliki strony muszą być w kontenerze pod /srv/start (wolumin z hosta).

{$DOMENA}:{$PORT_START} {
	encode gzip
	root * /srv/start
	@bezcache path / /index.html /gry.js /porty.js /strona.js /style.css
	header @bezcache Cache-Control "no-cache"
	file_server
}
